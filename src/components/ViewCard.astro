---
import { Image } from 'astro:assets';

// Img must be an imported image (not a string path) so Astro can optimize it
const { Type, Title, Img, ImgAltText, Date } = Astro.props;
---

<body>
		<div class="view-card">
				<p class="badge">{Type}</p>
				<h2>{Title}</h2>
				<Image src={Img} alt={ImgAltText} width={700} />
				<p>{Date}</p>
		</div>
</body>

<style lang="scss">
	.view-card {
		background-color: $color_white;
		padding-top: $spacing_extra-small;
		padding-bottom: $spacing_extra-small;
		padding-left: 12px;
		padding-right: 12px;
		box-shadow: $box_shadow_card;
	}

	.badge {
		background-color: $color_white;
		color: $color_black;
		font-family: $font_family_body;
		padding-top: $spacing_extra-small;
		padding-bottom: $spacing_extra-small;
		padding-left: $spacing_extra-small;
		padding-right: $spacing_extra-small;
		border-width: $border_width_button;
		border-radius: $border_radius_body;
		border-color: $color_black;
	}
</style>