---
import { Image } from 'astro:assets';

// Img must be an imported image (not a string path) so Astro can optimize it
// Link (optional): where the whole card goes when clicked
const { Type, Title, Img, ImgAltText, Date, Link } = Astro.props;
const Tag = Link ? 'a' : 'div';
---

<Tag class="view-card" href={Link}>
	<p class="badge">{Type}</p>
	<h3>{Title}</h3>
	<Image src={Img} alt={ImgAltText} width={700} />
	<p>{Date}</p>
</Tag>

<style lang="scss">
	.view-card {
		display: flex;
		flex-direction: column;
		box-sizing: border-box;
		background-color: $color_white;
		padding-top: $spacing_extra-small;
		padding-bottom: $spacing_extra-small;
		padding-left: 12px;
		padding-right: 12px;
		box-shadow: $box_shadow_card;
		color: inherit;
		text-decoration: none;
	}

	// Overrides the global a:hover (accent): the text stays black, only the title underlines
	.view-card:hover {
		color: $color_black;
		text-decoration: none;
	}

	.view-card:hover h3 {
		text-decoration: underline;
	}

	.view-card h3 {
		font-weight: normal;
		line-height: 1.2;
		min-height: 2.4em; // always reserves two lines, so every card's title takes the same height
	}

	.badge {
		background-color: $color_white;
		color: $color_black;
		font-family: $font_family_body;
		padding-top: $spacing_extra-small;
		padding-bottom: $spacing_extra-small;
		padding-left: $spacing_extra-small;
		padding-right: $spacing_extra-small;
		width: fit-content;
		border: 1px solid $color_black;
		border-radius: $border_radius_body;
	}

	.view-card :global(img) {
		display: block;
		width: 100%;
		height: auto; // overrides the height attribute so aspect-ratio decides the height
		aspect-ratio: 4 / 3; // every image is the same size on every card
		object-fit: cover; // scaled proportionally and cropped to fit, never stretched
	}

	.view-card h3,
	.view-card p {
		margin: 0;
	}

	// Space between the badge and the title
	.view-card .badge {
		margin-bottom: $spacing_extra-small;
	}

	// Space between the title and the image
	.view-card h3 {
		margin-bottom: $spacing_extra-small;
	}

	// Space between the image and the date
	.view-card :global(img) + p {
		margin-top: $spacing_extra-small;
	}
</style>