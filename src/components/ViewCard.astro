---
import { Image } from 'astro:assets';

// Img must be an imported image (not a string path) so Astro can optimize it
const { Type, Title, Img, ImgAltText, Date } = Astro.props;
---

<div class="view-card">
	<p class="badge">{Type}</p>
	<h3>{Title}</h3>
	<Image src={Img} alt={ImgAltText} width={700} />
	<p>{Date}</p>
</div>

<style lang="scss">
	.view-card {
		display: flex;
		flex-direction: column;
		gap: $spacing_extra-small; // same spacing between badge, title, image, and date on every card
		box-sizing: border-box;
		background-color: $color_white;
		padding-top: $spacing_extra-small;
		padding-bottom: $spacing_extra-small;
		padding-left: 12px;
		padding-right: 12px;
		box-shadow: $box_shadow_card;
	}

	.view-card:hover h3 {
		text-decoration: underline;
	}

	.view-card h3 {
		font-weight: normal;
	}

	.badge {
		background-color: $color_white;
		color: $color_black;
		font-family: $font_family_body;
		padding-top: $spacing_extra-small;
		padding-bottom: $spacing_extra-small;
		padding-left: $spacing_extra-small;
		padding-right: $spacing_extra-small;
		width: fit-content;
		border: 1px solid $color_black;
		border-radius: $border_radius_body;
	}

	.view-card :global(img) {
		display: block;
		width: 100%;
		height: auto; // keeps each image's own aspect ratio
	}

	.view-card h3,
	.view-card p {
		margin: 0;
	}
</style>