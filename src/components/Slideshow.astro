---
import { Image } from 'astro:assets';
const { Slides = [] } = Astro.props;
---

<div class="slideshow">
	<div class="slides">
		{Slides.map((Slide: { Img: ImageMetadata; ImgAltText: string }, index: number) => (
			<div class="slide" class:list={{ current: index === 0 }}>
				<Image src={Slide.Img} alt={Slide.ImgAltText} width={1200} loading={index === 0 ? "eager" : "lazy"} />
			</div>
		))}
	</div>
</div>

<script>
	const AUTO_ADVANCE_MS = 5000;

	document.querySelectorAll<HTMLElement>(".slideshow").forEach((slideshow) => {
		const slides = Array.from(slideshow.querySelectorAll<HTMLElement>(".slide"));
		let current = 0;
		let timer: number | undefined;

		function show(index: number) {
			slides[current].classList.remove("current");
			current = (index + slides.length) % slides.length;
			slides[current].classList.add("current");
		}

		function start() {
			stop();
			if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
			timer = window.setInterval(() => show(current + 1), AUTO_ADVANCE_MS);
		}

		function stop() {
			window.clearInterval(timer);
		}

		slideshow.addEventListener("mouseenter", stop);
		slideshow.addEventListener("mouseleave", start);
		start();
	});
</script>

<style lang="scss">
	.slideshow {
		position: relative;
		width: 100%;
		height: 100%;
		overflow: hidden;
	}

	.slides {
		position: relative;
		width: 100%;
		height: 100%;
	}

	.slide {
		position: absolute;
		inset: 0;
		opacity: 0;
		transition: opacity 0.6s ease;
	}

	.slide.current {
		opacity: 1;
	}

	.slide :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
</style>
