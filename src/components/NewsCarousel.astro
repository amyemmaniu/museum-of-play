---
import NewsCard from './NewsCard.astro';
import SlideIndicator from './SlideIndicator.astro';

// Cards: list of { Title, Snippet, Img, ImgAltText, Link } (the same props as NewsCard)
const { Cards = [] } = Astro.props;
---

<div class="news-carousel">
	<div class="carousel-row">
		<button class="arrow arrow-prev" type="button" aria-label="Previous">
			<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12H5M11 5l-7 7 7 7" /></svg>
		</button>

		<div class="track">
			{Cards.map((card: { Title: string; Snippet: string | string[]; Img?: ImageMetadata; ImgAltText?: string; Link?: string }) => (
				<NewsCard Title={card.Title} Snippet={card.Snippet} Img={card.Img} ImgAltText={card.ImgAltText} Link={card.Link} />
			))}
		</div>

		<button class="arrow arrow-next" type="button" aria-label="Next">
			<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15M13 5l7 7-7 7" /></svg>
		</button>
	</div>

	<SlideIndicator Count={Cards.length} />
</div>

<script>
	document.querySelectorAll<HTMLElement>('.news-carousel').forEach((carousel) => {
		const track = carousel.querySelector<HTMLElement>('.track')!;
		const prev = carousel.querySelector<HTMLButtonElement>('.arrow-prev')!;
		const next = carousel.querySelector<HTMLButtonElement>('.arrow-next')!;
		const dots = Array.from(carousel.querySelectorAll<HTMLElement>('.dot'));
		const cards = Array.from(track.children) as HTMLElement[]; // the real cards (captured before any clones are added)
		const count = cards.length;

		// Distance from one card to the next (card width + the gap between cards)
		const step = () => (cards[1] ? cards[1].offsetLeft - cards[0].offsetLeft : track.clientWidth);

		// The carousel never hits an end. Copies of the last cards sit before the first card and copies of the
		// first cards sit after the last, as many as are on screen at once (one on phones, two on desktop).
		// Once scrolling settles on a copy, the track jumps to the identical real card.
		const isDesktop = window.matchMedia('(min-width: 768px)');
		let clones: HTMLElement[] = [];
		let pad = 0; // number of copies on each side

		function makeClone(card: HTMLElement) {
			const clone = card.cloneNode(true) as HTMLElement;
			clone.setAttribute('aria-hidden', 'true');
			clone.setAttribute('inert', ''); // keeps the copied "Read more" links out of the tab order
			return clone;
		}

		function buildClones() {
			clones.forEach((clone) => clone.remove());
			pad = count < 2 ? 0 : Math.min(isDesktop.matches ? 2 : 1, count);
			const before = cards.slice(count - pad).map(makeClone);
			const after = cards.slice(0, pad).map(makeClone);
			track.prepend(...before);
			track.append(...after);
			clones = [...before, ...after];
			jumpTo(pad);
		}

		// Moves instantly (no animation); scroll-snap is switched off so the jump can't be undone by snapping
		function jumpTo(position: number) {
			track.style.scrollSnapType = 'none';
			track.scrollLeft = position * step();
			setTimeout(() => (track.style.scrollSnapType = ''), 50);
		}

		function update() {
			const position = Math.round(track.scrollLeft / step());
			const index = (position - pad + count) % count;
			dots.forEach((dot, i) => dot.classList.toggle('active', i === index));
		}

		// After scrolling comes to rest on a copy, jump to the matching real card
		let settleTimer: number;
		function settle() {
			if (!pad) return;
			const position = Math.round(track.scrollLeft / step());
			if (position < pad) jumpTo(position + count);
			else if (position >= pad + count) jumpTo(position - count);
		}

		function applyLayout() {
			buildClones();
			update();
		}

		prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
		next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
		track.addEventListener('scroll', () => {
			update();
			clearTimeout(settleTimer);
			settleTimer = window.setTimeout(settle, 120);
		}, { passive: true });
		window.addEventListener('resize', update);
		isDesktop.addEventListener('change', applyLayout);
		applyLayout();
	});
</script>

<style lang="scss">
	.news-carousel {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: $spacing_extra-small; // between the cards and the indicator
	}

	.carousel-row {
		display: flex;
		align-items: center;
		gap: $spacing_small; // between the arrows and the cards
		width: 100%;
	}

	// Cards sit side by side; scroll-snap makes swiping (mobile) land on one card at a time
	.track {
		display: flex;
		flex: 1;
		gap: $spacing_small;
		min-width: 0;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scrollbar-width: none;
	}

	.track::-webkit-scrollbar {
		display: none;
	}

	// Mobile: one card at a time
	.track > :global(.news-card) {
		flex: 0 0 100%;
		scroll-snap-align: start;
	}

	// Arrows only on desktop (phones swipe)
	.arrow {
		display: none;
		flex-shrink: 0;
		align-items: center;
		justify-content: center;
		width: 3rem;
		height: 3rem;
		padding: 0;
		border: none;
		border-radius: 50%;
		background-color: $color_primary;
		color: $color_white;
		cursor: pointer;
	}

	.arrow:hover {
		background-color: $color_accent;
	}

	.arrow svg {
		width: 1.75rem;
		height: 1.75rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	@media (min-width: $breakpoint_desktop) {
		.arrow {
			display: flex;
		}

		// Desktop: two cards side by side
		.track > :global(.news-card) {
			flex-basis: calc((100% - #{$spacing_small}) / 2);
		}
	}
</style>
