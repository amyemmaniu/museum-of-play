---
// Checkbox: when true, a checkbox is shown before the label (default: no checkbox)
// Checked: whether that checkbox starts out checked
const { Text, Link, Checkbox = false, Checked = false } = Astro.props;
---

<div class="dropdown-item">
	{Checkbox
		? <label class="checkbox-label"><p><input class="checkbox" type="checkbox" checked={Checked} /><span>{Text}</span></p></label>
		: Link ? <a href={Link}><p>{Text}</p></a> : <p>{Text}</p>}
</div>

<style lang="scss">
	a {
		display: block;
		text-decoration: none;
	}

	p {
		margin: 0;
		color: $color_white;
		background-color: $color_black;
		font-size: $font_size_body;
		font-family: $font_family_body;
		text-align: center;
		padding: 0.75rem 0.625rem;
	}

	.checkbox-label {
		display: block;
		cursor: pointer;
	}

	// Checkbox row: box and label side by side
	p:has(.checkbox) {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: $spacing_extra-small; // between the checkbox and the label
	}

	// label text may shrink and break anywhere, so an unbroken long word can't push past the item's width
	.checkbox-label span {
		min-width: 0;
		overflow-wrap: anywhere;
	}

	.checkbox {
		appearance: none;
		flex-shrink: 0;
		position: relative;
		width: 1.25rem;
		height: 1.25rem;
		margin: 0;
		box-sizing: border-box;
		border: $border_width_button solid $color_black;
		background-color: $color_white;
		cursor: pointer;
	}

	// The checkmark: solid black, centered in the box
	.checkbox:checked::after {
		content: "";
		position: absolute;
		top: 45%;
		left: 50%;
		width: 0.3rem;
		height: 0.6rem;
		box-sizing: border-box;
		border-right: $border_width_button solid $color_black;
		border-bottom: $border_width_button solid $color_black;
		transform: translate(-50%, -50%) rotate(45deg);
	}

	@media (min-width: $breakpoint_desktop) {
		.dropdown-item {
			width: $width_dropdown;
		}

		// Hover effect on desktop only; phones have no hover
		.dropdown-item:hover {
			text-decoration: underline;
		}

		p {
			box-sizing: border-box;
			overflow-wrap: break-word; // long labels wrap onto more lines instead of widening the item
			color: $color_black;
			background-color: $color_gray;
			text-align: left;
			padding-left: $spacing_extra-small;
		}

		p:has(.checkbox) {
			justify-content: flex-start;
		}
	}
</style>
