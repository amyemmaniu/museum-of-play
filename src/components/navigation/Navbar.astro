---
import DropdownMenu from "./DropdownMenu.astro";
import logo from "../../assets/logo.svg";
---

<header class="header">
	<div class="header-bar">
		<a class="logo-link" href="/">
			<img class="logo" src={logo.src} alt="Museum of Play logo" />
		</a>

		<!-- Phone only: opens and closes the navigation menu -->
		<button class="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="main-navigation">
			<span class="bar"></span>
			<span class="bar"></span>
			<span class="bar"></span>
		</button>
	</div>

	<nav class="navbar" id="main-navigation">
		<DropdownMenu Label="Visit" Items={[{ Text: "Plan Your Visit" , Link: "/plan-your-visit"}, { Text: "Membership", Link: "/membership" }]} />
		<DropdownMenu Label="Explore" Items={[{ Text: "On View", Link: "/on-view" }]} />
		<DropdownMenu Label="Learn" Link="/learn" Items={[{ Text: "Residencies", Link : "/residencies" }, { Text: "Fellowships", Link: "/fellowships" }, { Text: "Blog", Link: "/blog" }]} />
		<DropdownMenu Label="About" Items={[{ Text: "Mission, Vision, and Values", Link: "/mission-vision-and-values" }, { Text: "Leadership", Link: "/leadership" }]} />
		<a class="navbar-link" href="/support">Support</a>
	</nav>
</header>

<script>
	// Phone layout: the hamburger button shows/hides the main navigation menu
	document.querySelectorAll<HTMLElement>(".header").forEach((header) => {
		const toggle = header.querySelector<HTMLButtonElement>(".menu-toggle");
		toggle?.addEventListener("click", () => {
			const isOpen = header.classList.toggle("open");
			toggle.setAttribute("aria-expanded", String(isOpen));
			toggle.setAttribute("aria-label", isOpen ? "Close menu" : "Open menu");
		});
	});
</script>

<style lang="scss">
	.header {
		display: flex;
		flex-direction: column;
		top: 0;
		width: 100%;
		box-sizing: border-box;
		padding: 10px;
		margin-left: 0px;
		margin-right: 0px;
		position: sticky;
		z-index: 100;
		background-color: $color_black;
	}

	// Logo on the left, hamburger button on the right
	.header-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: $spacing_small;
	}

	.logo-link {
		display: block;
		flex: 0 1 356px;
		min-width: 0; // lets the logo shrink to leave room for the button
	}

	.logo {
		display: block;
		width: 100%;
		height: 48px;
		object-fit: contain; // shrinks without distorting
		object-position: left center;
	}

	// Three bars that animate into an X when the menu is open
	.menu-toggle {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		flex-shrink: 0;
		width: 2.5rem;
		height: 2.5rem;
		box-sizing: border-box;
		padding: 0.5rem 0.375rem;
		border: none;
		background-color: transparent;
		cursor: pointer;
	}

	.menu-toggle:hover {
		background-color: transparent; // overrides global button:hover (accent)
	}

	.bar {
		display: block;
		width: 100%;
		height: 3px;
		border-radius: 2px;
		background-color: $color_white;
		transition: transform 0.3s ease, opacity 0.2s ease;
	}

	// Top and bottom bars move to the middle and rotate; the middle bar fades out
	.header.open .bar:nth-child(1) {
		transform: translateY(0.6875rem) rotate(45deg);
	}

	.header.open .bar:nth-child(2) {
		opacity: 0;
	}

	.header.open .bar:nth-child(3) {
		transform: translateY(-0.6875rem) rotate(-45deg);
	}

	// Phone: the menu is hidden until the hamburger button opens it
	.navbar {
		display: none;
		flex-direction: column;
		width: 100%;
		background-color: $color_black;
	}

	.header.open .navbar {
		display: flex;
	}

	.navbar-link {
		display: flex;
		align-items: center;
		height: 50px;
		padding: $spacing_extra-small;
		box-sizing: border-box;
		background-color: $color_black;
		color: $color_white;
		font-family: $font_family_heading;
		font-size: 1.25rem; // 20px
		font-weight: bold;
		text-decoration: none;
	}

	.navbar-link:hover {
		color: $color_white;
		text-decoration: underline;
	}

	@media (min-width: 768px) {
		.header {
			flex-direction: row;
			align-items: flex-start;
			justify-content: space-between;
			height: 70px;
		}

		// Browser: no hamburger; the logo and menu sit directly in the header row, as before
		.header-bar {
			display: contents;
		}

		.menu-toggle {
			display: none;
		}

		.logo-link {
			flex-shrink: 0;
		}

		.navbar {
			display: flex;
			flex-direction: row;
			align-items: flex-start;
			justify-content: flex-end;
			gap: 2.5rem; // 40px
			width: auto;
			height: 50px;
			padding: 0 25px;
			box-sizing: border-box;
		}

		.navbar-link {
			justify-content: center;
		}
	}
</style>
