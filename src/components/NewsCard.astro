---
import { Image } from 'astro:assets';

// Img must be an imported image (not a string path) so Astro can optimize it
// Snippet: a string, or a list of strings (one paragraph each)
// Link (optional): the page the "Read more" button goes to
const { Title, Snippet, Img, ImgAltText, Link } = Astro.props;

// Text wrapped in *asterisks* is italicized (e.g. exhibit titles). Returns alternating plain/italic pieces.
const withItalics = (text: string) =>
	text.split(/\*(.+?)\*/).map((part, i) => ({ part, italic: i % 2 === 1 }));
---

<div class="news-card">
	<div class="news-card-inner">
		<div class="news-card-content">
			<h2>{withItalics(Title).map(({ part, italic }) => italic ? <em>{part}</em> : part)}</h2>
			<div class="snippet">
				{(Array.isArray(Snippet) ? Snippet : [Snippet]).filter(Boolean).map((paragraph: string) => <p>{withItalics(paragraph).map(({ part, italic }) => italic ? <em>{part}</em> : part)}</p>)}
			</div>
			{Link
				? <a class="read-more" href={Link}>Read more</a>
				: <button class="read-more" type="button">Read more</button>}
		</div>
		{Img && (
			<div class="news-card-image">
				<Image src={Img} alt={ImgAltText ?? ""} width={700} />
			</div>
		)}
	</div>
</div>

<style lang="scss">
	// Desktop is the default. On phones, the card is a scaled-down copy of it: each size in the phone block below is its
	// desktop value as a share of the desktop card width (520px), measured against the card's own width (cqw), so the
	// proportions match.
	$desktop-card-width: 520;
	@function scaled($px) {
		@return calc(#{$px} / #{$desktop-card-width} * 100cqw);
	}

	.news-card {
		container-type: inline-size; // lets the phone sizes use cqw (1% of this card's width)
		box-sizing: border-box;
		width: 100%;
		border-radius: $border_radius_card;
		background-color: $color_white;
		border: 1px solid rgba($color_gray, 0.5);
	}

	.news-card-inner {
		display: flex;
		flex-direction: row;
		align-items: stretch; // the text column is as tall as the image
		gap: $spacing_extra-small; // between the text column and the image
		padding: $spacing_extra-large;
	}

	// Left column: title, snippet, and the button pinned to the bottom
	.news-card-content {
		display: flex;
		flex: 1 1 0;
		flex-direction: column;
		min-width: 0;
	}

	.news-card h2 {
		display: flex;
		align-items: center;
		justify-content: center;
		margin: 0;
		min-height: 2.4em; // always reserves two lines, so a wrapping title doesn't change the card's height
		font-family: $font_family_body;
		font-size: $font_size_h3;
		font-weight: normal;
		line-height: 1.2;
		text-align: center;
	}

	.snippet {
		flex: 1; // takes the leftover height, which pushes the button to the bottom
		margin: $spacing_extra-small 0;
		text-align: left;
	}

	.snippet p {
		margin: 0;
		font-size: $font_size_body;
	}

	// $spacing_small between paragraphs
	.snippet p + p {
		margin-top: $spacing_small;
	}

	.read-more {
		padding: $spacing_extra-small;
		border: none;
		border-radius: $border_radius_body;
		background-color: $color_primary;
		color: $color_white;
		font-family: $font_family_body;
		font-size: $font_size_h3;
		cursor: pointer;
		text-align: center;
		text-decoration: none;
	}

	.read-more:hover {
		background-color: $color_accent;
		color: $color_white; // overrides global a:hover (accent), which would match the new background and hide the text
	}

	// Right column: portrait image that sets the card's height
	.news-card-image {
		flex: 1 1 0;
		min-width: 0;
		aspect-ratio: 551 / 666;
	}

	.news-card-image :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	// Phone: every desktop size above, scaled to the card's width
	@media (max-width: 767px) {
		.news-card-inner {
			gap: scaled($spacing_extra-small);
			padding: scaled($spacing_extra-large);
		}

		.news-card h2,
		.read-more {
			font-size: scaled($font_size_h3);
		}

		.snippet {
			margin: scaled($spacing_extra-small) 0;
		}

		.snippet p {
			font-size: scaled($font_size_body);
		}

		.snippet p + p {
			margin-top: scaled($spacing_small);
		}

		.read-more {
			padding: scaled($spacing_extra-small);
			border-radius: scaled($border_radius_body);
		}
	}
</style>
