---
import { Image } from 'astro:assets';

const { Title, Img, ImgAltText } = Astro.props;
---

<div class="collection-card">
	<h2>{Title}</h2>
	<div class="collection-card-image">
		<Image src={Img} alt={ImgAltText} width={700} />
	</div>
</div>

<style lang="scss">
	.collection-card {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.68rem;
		width: 100%;
		box-sizing: border-box;
		background-color: $color_black;
		padding: 0.68rem 0.91rem;
	}

	.collection-card h2 {
		margin: 0;
		width: 100%;
		color: $color_white;
		font-family: $font_family_body;
		font-size: 1.4535rem;
		font-weight: normal;
		text-align: center;
	}

	.collection-card-image {
		width: 100%;
		aspect-ratio: 4032 / 3024;
	}

	.collection-card-image :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.collection-card:hover {
		h2 {
			text-decoration: underline;
		}
	}

	@media (min-width: $breakpoint_desktop) {
		.collection-card {
			gap: 1.5vh;
			padding: 1.5vh 1.5vw;
		}

		.collection-card h2 {
			font-size: 2vw;
		}
	}
</style>
