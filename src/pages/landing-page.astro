---
import ViewCard from '../components/ViewCard.astro';
import CollectionCard from '../components/CollectionCard.astro';
---

<!DOCTYPE html>
<html lang="en">
	<body>
		<h3>Admission is free for students and children under 6</h3>
		<a href="#">Plan your visit today &gt;</a>

		<h1>Check Out What's New</h1>

		<ViewCard Type="Exhibition"
			Title="Play by the Rules: Politics, Society, and Board Games"
			Img="../assets/images/explore_collections_card-games.jpg"
			ImgAltText="Playing cards and game pieces on a yellow background"
			Date="November 18, 2026–March 7, 2027">
		</ViewCard>

		<ViewCard Type="Exhibition"
			Title="Chloë Braun: a sky that stretches into infinity"
			Img="..assets/images/on_view_chloe-braun.jpg"
			ImgAltText="A black and white photograph of a domed ceiling with a circular skylight"
			Date="Permanent Installation">
		</ViewCard>

		<ViewCard Type="Exhibition"
			Title="Mallory Blackwell: DISC/ONNECT"
			Img="../assets/images/on_view_mallory-blackwell.jpg"
			ImgAltText="A photograph of a vintage console in a blue-painted room"
			Date="Permanent Installation">
		</ViewCard>

		<a href="#">See what else is on view &gt;</a>

		<h1>Explore Our Collections</h1>

		<CollectionCard Title="Board Games"
			Img="../assets/images/explore_collections_board-games.jpg"
			ImgAltText="Playing cards and game pieces on a yellow background">
		</CollectionCard>

		<CollectionCard Title="Card Games"
			Img="../assets/images/explore_collections_card-games.jpg"
			ImgAltText="Playing cards and game pieces on a yellow background">
		</CollectionCard>

		<CollectionCard Title="Toys"
			Img="../assets/images/explore_collections_toys.jpg"
			ImgAltText="A collection of colorful toys arranged against a light blue background">
		</CollectionCard>

		<div class="membership-promo">
			<h1>Play more. Learn more. Explore more. Become a member today.</h1>
			<p>Memberships starting from $35.99 per month. A membership can pay for itself in as few as 3 visits!</p>
			<ul>
				<li>Free entry to all exhibits and events</li>
				<li>3 free parking validations per month</li>
				<li>Discounts on all gift shop items</li>
				<li>Members-only exhibit previews</li>
			</ul>
			<button class="purchase-membership-button">Purchase Membership</button>
		</div>
	</body>
</html>