	<style lang="scss">
		.not-found p {
			font-size: $font_size_h1-mobile;
			font-family: $font_family_heading;
		}

		@media (min-width: 768px) {
			.not-found p {
				font-size: $font_size_h1-desktop;
			}
		}
	</style>
</html>