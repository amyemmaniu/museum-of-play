---
import Navbar from '../components/navigation/Navbar.astro';
---

<!DOCTYPE html>
<html lang="en">
	<head><Navbar></Navbar></head>
	<body>
		<div class="not-found">
			<p>404</p>
			<p>Oops! Looks like that page isn't available right now.</p>
			<p>Why not check out <a href="/on-view">what's new</a> or read <a href="/blog">our blog</a>?</p>
		</div>
