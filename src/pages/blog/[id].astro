---
import '../../styles/global.scss';
import favicon from '../../assets/favicon.svg';
import '@fontsource/rubik/400.css';
import '@fontsource/rubik/400-italic.css';
import '@fontsource/rubik/700.css';
import '@fontsource/kode-mono/400.css';
import '@fontsource/kode-mono/700.css';
import '../../styles/blog-post.scss';
import Navbar from '../../components/navigation/Navbar.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';

// One page per blog post, at /blog/<post id>/
export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// MM/DD/YYYY (UTC, so the day never shifts with the viewer's time zone)
const d = post.data.date;
const date = `${String(d.getUTCMonth() + 1).padStart(2, '0')}/${String(d.getUTCDate()).padStart(2, '0')}/${d.getUTCFullYear()}`;

const crumbs = [
	{ Title: "Home", Link: "/" },
	{ Title: "Learn", Link: "/learn" },
	{ Title: "Blog", Link: "/blog" },
	{ Title: post.data.title, Link: "" },
];
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={favicon.src} />
		<title>{post.data.title}</title>
		<Navbar></Navbar>
	</head>
	<h1>{post.data.title}</h1>
	<body>
		<Breadcrumbs Crumbs={crumbs} />
		<p><b>{date}</b></p>
		{post.data.images.map((image) => (
			<Image class="post-image" src={image.src} alt={image.alt} />
		))}
		<Content />
	</body>
</html>
