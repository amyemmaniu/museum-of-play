---
import '../styles/global.scss';
import favicon from '../assets/favicon.svg';
import '@fontsource/rubik/400.css';
import '@fontsource/rubik/400-italic.css';
import '@fontsource/rubik/700.css';
import '@fontsource/kode-mono/400.css';
import '@fontsource/kode-mono/700.css';
import '../styles/membership.scss';
import Navbar from '../components/navigation/Navbar.astro';
import MembershipCard from '../components/MembershipCard.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { Image } from 'astro:assets';
import checkmark from '../assets/checkmark.svg';

const crumbs = [
	{ Title: "Home", Link: "/" },
	{ Title: "Visit", Link: "/plan-your-visit" },
	{ Title: "Membership", Link: "" },
];

// Comparison table content: one row per benefit. true = included (shows a checkmark).
const planNames = ["Individual", "Duo", "Family"];
const comparisonRows: { Benefit: string; Values: (boolean | string)[] }[] = [
	{ Benefit: "People covered", Values: ["1", "2", "Up to 4"] },
	{ Benefit: "Free entry to all exhibits and events", Values: [true, true, true] },
	{ Benefit: "3 free parking validations per month", Values: [true, true, true] },
	{ Benefit: "Discounts on all gift shop items", Values: [true, true, true] },
	{ Benefit: "Members-only exhibit previews", Values: [true, true, true] },
];
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={favicon.src} />
		<Navbar></Navbar>
	</head>
	<body>
		<h1>Membership</h1>
		<Breadcrumbs Crumbs={crumbs} />

		<p>
			Make the Museum of Play part of your routine.
			Visit as often as you like, enjoy exclusive looks at upcoming exhibits and events, and experience more perks.
		</p>

		<div class="membership-card-group">
			<MembershipCard PlanName="Individual"
				Price="35.99"
				BorderColor="var(--color_secondary)"
				Description="Membership for one person">
			</MembershipCard>

			<MembershipCard PlanName="Duo"
				Price="68.99"
				BorderColor="var(--color_tertiary)"
				Description="Membership for two people">
			</MembershipCard>

			<MembershipCard PlanName="Family"
				Price="149.99"
				BorderColor="var(--color_accent)"
				Description="Membership for the whole family—up to 4 people">
			</MembershipCard>
		</div>

		<h2>Membership Plan Comparison</h2>
		<div class="membership-comparison-table">
			<table>
				<thead>
					<tr>
						<th scope="col">Benefits</th>
						{planNames.map((planName) => <th scope="col">{planName}</th>)}
					</tr>
				</thead>
				<tbody>
					{comparisonRows.map((row) => (
						<tr>
							<th scope="row">{row.Benefit}</th>
							{row.Values.map((value) => (
								<td>
									{value === true ? <Image src={checkmark} alt="Included" width={32} /> : value}
								</td>
							))}
						</tr>
					))}
				</tbody>
			</table>
		</div>
	</body>
</html>
